# Copy to .env (repo root) and fill in. The backend loads it automatically on start.
# Never commit .env: it holds your secrets.

# --- AI extraction (Google Gemini, free tier: https://aistudio.google.com/apikey) ---
# Leave LLM_API_KEY empty to run with the offline rule-based extractor only.
LLM_PROVIDER=gemini
LLM_API_KEY=
# LLM_MODEL=gemini-flash-lite-latest
# LLM_REASONING_EFFORT=low
# LLM_CONCURRENCY=2

# --- Search ---
# fastembed = real semantic search (bge-small, ~130 MB download on first use); hash = offline lexical vectors
EMBEDDING_BACKEND=fastembed

# --- Security ---
# Optional key for the DocIntel API itself (NOT the Gemini key). If set, every /api call needs
# an X-API-Key header; set the same value in frontend/.env.local so the web app can send it.
API_KEY=

# --- Optional production services (defaults: SQLite + in-process background worker) ---
# DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel
# REDIS_URL=redis://localhost:6379/0
# TASK_MODE=celery
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
